{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 调试 (OpenOCD + ST-Link)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/MDK-ARM/Fire_F103_2/Fire_F103_2.axf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerArgs": "",
            "preLaunchTask": "Build: ARM 编译 (PowerShell)",
            "setupCommands": [
                {
                    "description": "启用 GDB 美化打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "customLaunchSetupCommands": [
                {
                    "text": "target remote localhost:3333",
                    "description": "连接到 OpenOCD"
                },
                {
                    "text": "set mem inaccessible-by-default off",
                    "description": "允许访问所有内存"
                },
                {
                    "text": "monitor reset halt",
                    "description": "复位并停止在复位向量"
                },
                {
                    "text": "load",
                    "description": "加载程序"
                },
                {
                    "text": "monitor reset init",
                    "description": "初始化目标设备"
                }
            ],
            "launchCompleteCommand": "exec-run",
            "serverStartupCommand": "openocd -f interface/stlink.cfg -f target/stm32f1x.cfg",
            "windows": {
                "miDebuggerPath": "arm-none-eabi-gdb.exe"
            }
        },
        {
            "name": "STM32 调试 (Cortex-Debug 扩展)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/MDK-ARM/Fire_F103_2/Fire_F103_2.axf",
            "target": "extended-remote",
            "port": 3333,
            "interface": "swd",
            "device": "STM32F103C8",
            "preLaunchTask": "Build: ARM 编译 (PowerShell)",
            "armToolchainPath": "${workspaceFolder}",
            "openocdConfig": [],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 72000000,
                "swoFrequency": 4000000,
                "source": "probe"
            }
        },
        {
            "name": "STM32 调试 (通过 Telnet 连接 OpenOCD)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/MDK-ARM/Fire_F103_2/Fire_F103_2.axf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "preLaunchTask": "Build: ARM 编译 (PowerShell)",
            "setupCommands": [
                {
                    "description": "启用 GDB 美化打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "连接到 OpenOCD",
                    "text": "target extended-remote localhost:3333"
                },
                {
                    "description": "设置内存访问权限",
                    "text": "set mem inaccessible-by-default off"
                },
                {
                    "description": "复位并停止",
                    "text": "monitor reset halt"
                },
                {
                    "description": "加载程序到闪存",
                    "text": "load"
                }
            ],
            "launchCompleteCommand": "exec-continue"
        }
    ]
}